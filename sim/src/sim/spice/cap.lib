*******************************************
*  Capacitor SPICE Model
*  Subckt Name: C105_cer
*  Parameterized version
*******************************************
*
.SUBCKT C_real 1 4 PARAMS: Resr=0.03 Rleak=100e12 Cval=1e-6 fo=1e6
*
.PARAM Lval={1/((2*3.14159265358979*fo)**2 * Cval)}
*
L1    1     2     {Lval}
R1    2     3     {Resr}
C1    3     4     {Cval}
R2    3     4     {Rleak}
.ENDS


.subckt C_ideal 1 2 PARAMS: C=1u ESR=10m ESL=1n RLEAK=1G

* Unused parameters are retained for interface compatibility.
C1 1 2 {C}

.ends

.subckt C_cv p n Cval=1e-6 k=0.01 Imin=3u Rmin=1 Rmax=1M
* Ideal capacitor with voltage-proportional leakage and a minimum floor.
*
* Has minimum and maximum values for leakage resistance.
*
*   I_leak = max(k*Cval*|V|, Imin)  (units: A, with Cval in F and V in V)
*   k    : scalar on the leakage current (0.01 is the usual 0.01CV rule)
*   Imin : minimum leakage current in amps
*
*
C1    p n {Cval}
Rleak p n R='min(max(max(k * Cval * abs(v(p,n)), abs(v(p,n)) / Imin), Rmin), Rmax)'

* Debug statements
*Brprobe rprobe 0 V='min(max(max(k * Cval * abs(v(p,n)), abs(v(p,n)) / Imin), Rmin), Rmax)'
*Bvprobe vprobe 0 V='v(p,n)'
*Bcvprobe cvprobe 0 V='k * Cval * abs(v(p,n))'
*Biprobe iprobe 0 V='abs(v(p,n)) / Imin'

.ends C_cv
